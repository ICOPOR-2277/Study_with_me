

# development | production
APP_ENV=development

# PostgreSQL. Local: postgresql://USUARIO:CLAVE@localhost:5432/study_with_me
# En Render se llena sola desde la base de datos (ver render.yaml).
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/study_with_me

# Clave para firmar los tokens (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Duración de la sesión en minutos (720 = 12 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Orígenes permitidos por CORS, separados por comas (producción: la URL de tu Flutter Web).
# En desarrollo ya se acepta cualquier puerto de localhost.
CORS_ORIGINS=

# Zona horaria de las reuniones
APP_TIMEZONE=America/Bogota

# Verificación de correo
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=48

# Resend (https://resend.com) para enviar el código al correo de la persona.
# Si RESEND_API_KEY está vacía, el código solo se escribe en el log del servidor (solo desarrollo).
# RESEND_FROM: con el dominio de pruebas de Resend usa  Study With Me <onboarding@resend.dev>
#   (solo entrega al correo con el que creaste tu cuenta de Resend). Para enviar a cualquier
#   correo debes verificar un dominio propio en Resend y usar, por ejemplo,  Study With Me <no-reply@tudominio.com>
RESEND_API_KEY=
RESEND_FROM=

# SMTP (opcional; solo se usa si no hay Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cuenta de administrador (panel en /panel). Si defines ambas, se crea al arrancar la API (si no existe).
# ADMIN_PASSWORD: mínimo 8 caracteres; no se cambia sola si la cuenta ya existe. Ponla solo en tu .env / en Render, nunca en Git.
ADMIN_EMAIL= memesrandom1231@gmail.com  
ADMIN_PASSWORD= salchipapaforever123