# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# development | production
APP_ENV=development

# PostgreSQL. Local: postgresql://USUARIO:CLAVE@localhost:5432/study_with_me
# En Render se llena sola desde la base de datos (ver render.yaml).
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/study_with_me

# Clave para firmar los tokens (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Duración de la sesión en minutos (720 = 12 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Orígenes permitidos por CORS, separados por comas (producción: la URL de tu Flutter Web).
# En desarrollo ya se acepta cualquier puerto de localhost.
CORS_ORIGINS=

# Zona horaria de las reuniones
APP_TIMEZONE=America/Bogota

# Verificación de correo
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=48

# SMTP (opcional). Si SMTP_HOST está vacío, el código de verificación solo se escribe en el log del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
